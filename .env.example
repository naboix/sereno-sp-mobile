# ============================================================
# Sereno SP Mobile - variáveis de ambiente (copie para .env)
# Nenhum segredo deve ser colocado aqui: variáveis EXPO_PUBLIC_
# são embutidas no aplicativo e ficam visíveis para qualquer um.
# ============================================================

# Modo de dados:
#   api  -> consome a Sereno.Api (.NET) real ou o servidor de contrato simulado
#   mock -> demonstração 100% offline com dados SIMULADOS embutidos no app
EXPO_PUBLIC_DATA_MODE=api

# URL base da API, SEM barra no final. Escolha conforme onde o app roda:
#   Emulador Android ........ http://10.0.2.2:5128
#   Simulador iOS / Web ..... http://localhost:5128
#   Celular físico (Expo Go)  http://<IP-DO-SEU-PC-NA-REDE>:5128   (ex.: http://192.168.0.15:5128)
# 5128 é a porta do perfil "http" em Sereno.Api/Properties/launchSettings.json.
EXPO_PUBLIC_API_URL=http://10.0.2.2:5128

# Código do totem cuja última leitura aparece na tela Início.
# Se vazio, o app usa o primeiro totem ativo retornado por GET /api/totens.
EXPO_PUBLIC_TOTEM_CODIGO=

# Tempo máximo de espera de cada requisição, em milissegundos.
EXPO_PUBLIC_API_TIMEOUT_MS=8000
